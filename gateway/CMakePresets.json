{
  "version": 6,
  "configurePresets": [
    {
      "name": "vcpkg-installed",
      "displayName": "CommonNet / protobuf from installed vcpkg",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{VCPKG_ROOT}/installed/x64-windows",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "vcpkg-installed",
      "configuration": "Release"
    }
  ]
}
