{
  "listen": {
    "host": "127.0.0.1",
    "port": 27005
  },
  "backend": {
    "base": "http://127.0.0.1:27004",
    "protocol": "tcp",
    "timeout_ms": 5000,
    "startup_wait": true,
    "startup_retry_interval_sec": 30,
    "startup_max_attempts": 5
  },
  "rate_limit": {
    "capacity": 600,
    "refill_per_sec": 20
  },
  "auth": {
    "access_ttl_sec": 86400,
    "refresh_ttl_sec": 2592000
  },
  "log_level": "info"
}

