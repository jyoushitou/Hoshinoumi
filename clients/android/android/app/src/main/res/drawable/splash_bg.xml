<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#0B1D3A" android:endColor="#07101F" android:type="linear" />
        </shape>
    </item>
    <item android:left="-120dp" android:top="-180dp" android:right="40dp" android:bottom="260dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="220dp" android:startColor="#331D4ED8" android:endColor="#001D4ED8" />
        </shape>
    </item>
</layer-list>
