{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hoshinoumi",
  "version": "35.6.0",
  "identifier": "com.hoshinoumi.desktop",
  "build": {
    "frontendDist": "../../../integrations/web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hoshinoumi",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 760,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}