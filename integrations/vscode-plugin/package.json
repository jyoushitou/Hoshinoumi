{
  "name": "hoshinoumi-vscode",
  "displayName": "Hoshinoumi for VS Code",
  "description": "在 VS Code 里连接 Hoshinoumi：nao 聊天、记忆、存钱、人设、周计划表",
  "version": "35.4.3",
  "publisher": "hoshinoumi",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:hoshinoumi.sidebar",
    "onCommand:hoshinoumi.open",
    "onCommand:hoshinoumi.configure"
  ],
  "main": "./extension.js",
  "contributes": {
    "views": {
      "hoshinoumi": [
        {
          "id": "hoshinoumi.sidebar",
          "name": "Hoshinoumi",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "hoshinoumi.open",
        "title": "打开 nao",
        "category": "Hoshinoumi"
      },
      {
        "command": "hoshinoumi.configure",
        "title": "配置后端",
        "category": "Hoshinoumi"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hoshinoumi",
          "title": "Hoshinoumi",
          "icon": "media/nao.svg"
        }
      ]
    }
  }
}
